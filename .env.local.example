# Supabase Configuration
# Replace with your project details from Supabase Dashboard > Project Settings > API

# Public credentials (available in both Client and Server Components)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials (OPTIONAL: never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Required to create accounts and send their invitation emails
# Use the public origin for this deployment, without a trailing path.
INVENTORY_SITE_URL=https://inventory.example.gov.ph
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Required only for the first account setup (at least 32 random characters)
INVENTORY_BOOTSTRAP_SECRET=
