# Supabase Configuration
# Replace with your project details from Supabase Dashboard > Project Settings > API

# Public credentials (available in both Client and Server Components)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials (required; never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Required only for the first account setup (at least 32 random characters)
INVENTORY_BOOTSTRAP_SECRET=

# Server-only security settings; use a separate random limiter key of at least 32 characters
# INVENTORY_APP_ORIGIN is required on Vercel for password recovery redirects
INVENTORY_RATE_LIMIT_SECRET=
INVENTORY_APP_ORIGIN=https://inventory.example.gov
