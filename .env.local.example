# Supabase Configuration
# Replace with your project details from Supabase Dashboard > Project Settings > API

# Public credentials (available in both Client and Server Components)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only credentials (OPTIONAL: never prefix with NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# Server-only: enables AI-assisted grammar and clarity suggestions for remarks
OPENAI_API_KEY=
# Optional; defaults to gpt-6-luna
OPENAI_REMARKS_MODEL=
